# Nunca comitar chaves, ambiente ou dados do usuário
.env
venv/
.venv/
node_modules/
dados/
logs/
__pycache__/
*.pyc
.pytest_cache/
build/
electron/dist*/
*.zip
*.spec
*.log
.ultron-state.json

# Binários compilados: gerados por tools/build_setup.py (entram no ZIP do Release, não no repositório)
*.exe
build/

# Chave privada de assinatura (nunca versionar)
.ultron-signing/
*.pem

# Cofre de credenciais (cifrado, mas é dado do usuário)
dados/cofre.json
dados/.cofre.chave

# --- Segredos e ambiente adicionais ---
.env.*
!.env.example
!**/.env.example
secrets/
*.key

# --- Sistema Windows ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- IDEs e editores ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Builds e instaladores (não versionar binários) ---
*.msi
*.dmg
installer/output/
installer/build/

# --- Testes e cobertura ---
htmlcov/
.coverage
.coverage.*

# --- Notas e planos internos do agente (locais, não versionar) ---
.internal/

# --- Outros temporários ---
*.tmp
*.temp
.DS_Store

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
