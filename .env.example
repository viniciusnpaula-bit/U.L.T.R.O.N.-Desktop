# ===== ULTRON - CONFIGURAÇÃO =====
# Seu nome/tratamento (ex: senhor, Pedro)
NOME_USUARIO=senhor

# Chave grátis do Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Chave grátis do Groq (reserva): https://console.groq.com/keys
GROQ_API_KEY=
# Chave da NVIDIA Build: https://build.nvidia.com/
NVIDIA_API_KEY=

# Ordem de tentativa dos provedores
PROVEDORES=gemini,groq,nvidia
# Se algum modelo for descontinuado, troque o nome aqui
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_MODEL=openai/gpt-oss-20b

# Voz (mais negativo = mais grave)
VOZ=pt-BR-AntonioNeural
VOZ_PITCH=-12Hz
VOZ_RATE=+0%

# Sensibilidade do microfone (0 = automático)
LIMIAR_VOZ=0
# Segundos de silêncio para considerar que você terminou de falar (menor = responde mais rápido, mas pode cortar pausas)
SILENCIO_FIM=0.5
# Esforço de raciocínio do gpt-oss no Groq: low (rápido), medium, high. Deixe vazio para desligar.
REASONING_EFFORT=
# Quantas mensagens do histórico a IA recebe a cada resposta (menos = mais rápido)
HISTORICO_MSGS=8

# Segundos em que uma fala sem "Ei, Ultron" continua valendo como comando depois
# de uma resposta (0 desliga: só responde com o nome de ativação)
JANELA_SEGUIMENTO=6

# Segurar para falar: grava enquanto você mantém a combinação e envia o comando ao
# soltar (não precisa do "Ei, Ultron"). Deixe vazio para desligar.
HOTKEY_FALAR=ctrl+alt+espaco

# Atalho global de parada de emergência
HOTKEY_PARAR=ctrl+alt+x

# PIN para confirmar ações CRÍTICAS no Desktop (ex.: comandos de terminal).
# No Desktop, sem PIN configurado e válido a ação é cancelada. Nunca por voz.
ULTRON_PIN=

# Opcional: controle pelo celular via Telegram
# Token: fale com @BotFather | Seu ID: fale com @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_USER_ID=
