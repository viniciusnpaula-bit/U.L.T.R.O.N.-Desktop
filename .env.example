# ===== ULTRON - CONFIGURAÇÃO =====
# Seu nome/tratamento (ex: senhor, Pedro)
NOME_USUARIO=senhor

# Chave grátis do Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Chave grátis do Groq (reserva): https://console.groq.com/keys
GROQ_API_KEY=
# Chave da NVIDIA Build: https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
# Outras plataformas (todas compatíveis com a API da OpenAI; use só as que tiver)
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OpenRouter (vários modelos, inclusive grátis): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Mistral: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Cerebras: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
# Together AI: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=
# xAI (Grok): https://console.x.ai/
XAI_API_KEY=

# Ordem de tentativa dos provedores (quem não tem chave é pulado)
PROVEDORES=groq,gemini,nvidia,openai,openrouter,mistral,deepseek,cerebras,together,xai
# Se algum modelo for descontinuado, troque o nome aqui
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_MODEL=openai/gpt-oss-20b
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_MODEL=openai/gpt-4o-mini
MISTRAL_MODEL=mistral-small-latest
DEEPSEEK_MODEL=deepseek-chat
CEREBRAS_MODEL=llama-3.3-70b
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
XAI_MODEL=grok-2-latest

# Retry das chamadas de IA (backoff exponencial)
# Tentativas por provedor antes de cair para o próximo
IA_TENTATIVAS=4
# Espera inicial em segundos; dobra a cada tentativa (1, 2, 4...)
IA_BACKOFF_BASE=1.0
# Teto de uma espera, em segundos
IA_BACKOFF_TETO=16.0
# Jitter proporcional (0.5 = até +50%) para evitar rajadas sincronizadas
IA_BACKOFF_JITTER=0.5
# Tempo total máximo por provedor antes de desistir dele, em segundos
IA_TEMPO_MAX_PROVEDOR=45.0
# Tempo total máximo da chamada inteira, somando todos os provedores
IA_TEMPO_MAX_TOTAL=60.0

# Voz (mais negativo = mais grave)
VOZ=pt-BR-AntonioNeural
VOZ_PITCH=-12Hz
VOZ_RATE=+0%

# Sensibilidade do microfone (0 = automático)
LIMIAR_VOZ=0
# Segundos de silêncio para considerar que você terminou de falar (menor = responde mais rápido, mas pode cortar pausas)
SILENCIO_FIM=0.5
# Esforço de raciocínio do gpt-oss no Groq: low (rápido), medium, high. Deixe vazio para desligar.
REASONING_EFFORT=
# Quantas mensagens do histórico a IA recebe a cada resposta (menos = mais rápido)
HISTORICO_MSGS=12
# Memória entre sessões: quantos trechos antigos e relevantes entram no contexto
RECALL_MSGS=4
# Janela, em dias, em que a memória procura conversas antigas
RECALL_DIAS=120
# Memória no Obsidian: pasta do vault (vazio = Documents/ULTRON-Vault).
# As notas são Markdown comum; nada sai do computador.
OBSIDIAN_VAULT=
# Quantas notas do vault entram no contexto de cada resposta (0 desliga a leitura)
OBSIDIAN_RECALL=3
# Liga/desliga a integração inteira (leitura automática e ferramentas do vault)
OBSIDIAN_ATIVO=1
# Reconhecimento de voz: auto (Google e, se falhar, o motor do Windows),
# sempre (motor do Windows primeiro) ou nunca (só Google)
VOZ_NATIVA=auto

# Segundos em que uma fala sem "Ei, Ultron" continua valendo como comando depois
# de uma resposta (0 desliga: só responde com o nome de ativação)
JANELA_SEGUIMENTO=6

# Segurar para falar: grava enquanto você mantém a combinação e envia o comando ao
# soltar (não precisa do "Ei, Ultron"). Deixe vazio para desligar.
HOTKEY_FALAR=ctrl+alt+space

# Atalho global de parada de emergência
HOTKEY_PARAR=ctrl+alt+x

# PIN para confirmar ações CRÍTICAS no Desktop (ex.: comandos de terminal).
# No Desktop, sem PIN configurado e válido a ação é cancelada. Nunca por voz.
ULTRON_PIN=

# Opcional: controle pelo celular via Telegram
# Token: fale com @BotFather | Seu ID: fale com @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_USER_ID=
